# Copy to .env for local use. On Render these are set in the dashboard (see render.yaml).
APP_ENV=development
APP_NAME=OM Suite
SECRET_KEY=change-me-long-random-string

# Signups with these e-mails become approved admins immediately (comma separated).
# If empty, the very first signup becomes admin.
ADMIN_EMAILS=

# --- Firebase Firestore (persistent user store). Leave empty to use local SQLite (dev only). ---
FIREBASE_PROJECT_ID=ptp-report
# Paste the whole service-account JSON on ONE line, or point to a file:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIRESTORE_PREFIX=omsuite_

# URL of the separate gr_auto_modification_system deployment (opens from a dashboard tile)
GR_AUTO_URL=

# OmInsights (Metabase) - each user saves their own login in Settings; these are server-wide.
OMINSIGHTS_URL=https://ominsights.omlogistics.co.in
OMINSIGHTS_ALLOWED_CARDS=546,967
# Optional: key for encrypting saved OmInsights passwords (defaults to one derived from SECRET_KEY)
CREDENTIAL_KEY=

# Optional: Gemini key for the AI Chatbot's wording/fallback answers (numbers always come from the data)
GEMINI_ADMIN_API_KEY=
